# The app creates data/config.json on first start and uses SQLite by default.
# Environment variables are optional overrides for container deployments.

# CONFIG_FILE=data/config.json
# DATABASE_DRIVER=sqlite
# DATABASE_DSN=data/clipbox.db

# To use MySQL, set a Go MySQL DSN. When DATABASE_DRIVER is unset,
# DATABASE_DSN keeps backward compatibility by selecting the mysql driver.
# DATABASE_DSN=root:root@tcp(127.0.0.1:3306)/clipbox?charset=utf8mb4&parseTime=true&loc=UTC

# The legacy SQLAlchemy URL form is also accepted.
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/clipbox?charset=utf8mb4

# ADDRESS=:5328
# DATA_DIR=data
# Release binaries embed www/ at build time. WWW_ROOT is only used by
# server.New()/NewWithDependencies() callers that opt into disk-based serving.
# WWW_ROOT=www
# REAL_IP_HEADER=X-Real-IP
# MAX_TEXT_SIZE=5242880
# MAX_LINK_LENGTH=2048
# MAX_UPLOAD_FILE_SIZE=524288000
# UPLOAD_CHUNK_SIZE=4194304
# UPLOAD_WORKERS=4
# UPLOAD_SESSION_TTL=10m
