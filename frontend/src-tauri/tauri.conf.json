{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipBox",
  "version": "0.1.0",
  "identifier": "com.meterminator.clipbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipBox",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
